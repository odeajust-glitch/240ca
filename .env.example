# Moonshot AI key — https://platform.moonshot.ai
KIMI_API_KEY=sk-...

# Model tiers: fast answers first, slow used for the deeper search
# (and auto-retry when the fast model can't find an answer).
KIMI_MODEL_FAST=kimi-k2.6
KIMI_MODEL_SLOW=kimi-k3

PORT=5174

# Gates the usage dashboard at /stats.html — pick any long random string.
# Leave unset to disable the stats endpoint entirely.
STATS_KEY=

# Where usage counts are written. On Render this is the persistent disk
# mount (/var/data); locally it defaults to ./analytics.
# ANALYTICS_DIR=/var/data

# CATS sign-on (laptop only, never on Render): board-auto.js fills the CATS
# employee number and password after you've done Microsoft/Authenticator, and
# signs back in when CATS signs you out or a check gets stuck. Leave unset to
# sign in by hand.
CATS_EMPLOYEE_NO=
CATS_PASSWORD=

# Board check relay (laptop → phone). On Render, BOARD_KEY gates /api/board.
# On the laptop, board-auto.js pushes each check when both are set.
BOARD_KEY=
# BOARD_RELAY_URL=https://<your-app>.onrender.com
