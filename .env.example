# Moonshot AI key — https://platform.moonshot.ai
KIMI_API_KEY=sk-...

# Model tiers: fast answers first, slow used for the deeper search
# (and auto-retry when the fast model can't find an answer).
KIMI_MODEL_FAST=kimi-k2.6
KIMI_MODEL_SLOW=kimi-k3

PORT=5174

# Gates the usage dashboard at /stats.html — pick any long random string.
# Leave unset to disable the stats endpoint entirely.
STATS_KEY=

# Where usage counts are written. On Render this is the persistent disk
# mount (/var/data); locally it defaults to ./analytics.
# ANALYTICS_DIR=/var/data

# --- Board checker (board-auto.js) -----------------------------------------
# Put these in C:\Users\<you>\BoardChecker\.env (the data folder, off
# OneDrive), not in the repo. Snapshots of every check go to
# BoardChecker\history\<date>\<HHMM>.txt/.json, kept BOARD_HISTORY_DAYS days
# (default 90; 0 keeps all).
# BOARD_HISTORY_DAYS=90
#
# CATS sign-on (laptop only, never on Render): board-auto.js fills the CATS
# employee number and password after you've done Microsoft/Authenticator, and
# signs back in when CATS signs you out or a check gets stuck. Leave unset to
# sign in by hand.
CATS_EMPLOYEE_NO=
CATS_PASSWORD=
# Microsoft sign-in (laptop only). R in the checker window, or your turn
# showing on duty on the Sarnia Call Board, signs in to Microsoft fresh; you approve it in Authenticator. MS_PASSWORD is typed if
# Microsoft asks for it (once per sign-in). BOARD_NTFY_TOPIC: a hard-to-guess
# ntfy.sh topic your phone subscribes to, for the number to match.
MS_EMAIL=
MS_PASSWORD=
BOARD_NTFY_TOPIC=

# AI check of each board report (laptop only). Claude reads each check that
# changed and says "Looks right." or what looks off; it never changes the
# answer. Read again before every review, so you can change these while the
# script runs. No key → no review.
ANTHROPIC_API_KEY=
# BOARD_AI_MODEL=claude-opus-5-5
# BOARD_AI_REVIEW=off

# Browser the board checker drives: Microsoft Edge by default. Set
# BOARD_BROWSER=chromium to use Playwright's own Chromium instead.
# BOARD_BROWSER=chromium

# Board check relay (laptop → phone). On Render, BOARD_KEY gates /api/board.
# On the laptop, board-auto.js pushes each check when both are set.
BOARD_KEY=
# BOARD_RELAY_URL=https://<your-app>.onrender.com

# Line-up snapshot website on Netlify (laptop only). With both set,
# board-auto.js rebuilds the site from history\ and publishes it after a check
# that changed, at most every BOARD_SITE_EVERY minutes. Token: Netlify → User
# settings → Applications → Personal access tokens. Site ID: the site's
# Site configuration page. `node scripts/board-site.js --deploy` publishes by hand.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
# BOARD_SITE_EVERY=90
# BOARD_SITE_DAYS=30
